APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
DB_PASSWORD=change-me
AUTHENTICATOR_PASSWORD=change-me-too
# 32+ random bytes, e.g. `openssl rand -base64 48`. The API signs tokens with it and PostgREST verifies them.
JWT_SECRET=

# Email for password recovery (any SMTP service: Brevo, Resend, Gmail app password...). Optional, but without it "forgot password" cannot send the link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Mobile push notifications are sent through Expo. Leave empty unless you turned on enhanced push security (an access token from expo.dev).
EXPO_ACCESS_TOKEN=

# Browser push notifications. Make the pair with: node deploy/make-vapid-keys.mjs (the public key is built into the website image).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Registration fees. Encrypts the Razorpay keys organizers connect. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back it up with the rest of this file and never change it later.
SECRETS_KEY=
MAIL_FROM=

# Shown on the privacy policy and terms pages.
CONTACT_EMAIL=
